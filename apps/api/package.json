  "dependencies": {
    "@uinaf/attach-shared": "workspace:*",
    "jose": "^6.0.12"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250803.0",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "wrangler": "^4.28.0"
  }
}
