{
  "name": "@uinaf/attach-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "check": "vp check",
    "types": "wrangler types --env-file .dev.vars.example --include-runtime=false",
    "types:check": "wrangler types --env-file .dev.vars.example --include-runtime=false --check",
    "test": "vp test run && vitest run --config vitest.workers.config.ts",
    "test:workers": "vitest run --config vitest.workers.config.ts",
    "build": "wrangler deploy --dry-run --outdir=dist",
    "deploy": "node ./scripts/deploy.ts",
    "db:migrate:local": "wrangler d1 migrations apply attach --local",
    "db:migrate:remote": "wrangler d1 migrations apply attach --remote"
  },
  "dependencies": {
    "@uinaf/attach-shared": "workspace:*",
    "jose": "^6.0.12"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.11.1",
    "@cloudflare/workers-types": "^4.20250803.0",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "~3.2.0",
    "wrangler": "^4.28.0"
  }
}
